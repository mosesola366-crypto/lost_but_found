# Security Unit - PRS Uploads Security Rules
# Prevent execution of any scripts in the uploads directory

Options -ExecCGI -Indexes

<FilesMatch ".*">
    SetHandler default-handler
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pht|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd|shtml)$">
    Require all denied
</FilesMatch>
